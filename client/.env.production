# Production environment variables for performance optimization
#
# The API host is the deployed Render service. It used to be
# https://api.acreage.com, which does not resolve — every production request
# failed at DNS before CORS was ever reached, so the frontend appeared unable
# to talk to the backend. Change this only if the Render service is renamed.
VITE_API_URL=https://acreage-n2h1.onrender.com
VITE_SMS_NUMBER=0182142621
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true

# Performance optimization flags
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_OFFLINE_SUPPORT=true
VITE_CACHE_STRATEGY=networkFirst
VITE_IMAGE_OPTIMIZATION=true
