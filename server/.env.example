# Flask Core Configuration
FLASK_APP=app.py
FLASK_DEBUG=false

# Security Secrets (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Database Configuration (Local default SQLite or Production PostgreSQL)
DATABASE_URL=sqlite:///../instance/acreage.db

# Comma-separated CORS allowed origins — set to your production frontend domain in prod
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL for verification emails and redirects
FRONTEND_URL=http://localhost:5173

# ─── Safaricom M-Pesa (Daraja) Credentials ───
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_INITIATOR_NAME=your_b2c_initiator_username
MPESA_B2C_COMMAND=BusinessPayment
MPESA_CALLBACK_URL=https://your-domain.ngrok-free.app/api/orders/mpesa-callback

# ─── Email / Security ───
SECURITY_TOKEN_EXPIRES_MINUTES=30
# Keep false only for local development without SMTP. Production should be true.
EMAIL_VERIFICATION_REQUIRED=false
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_DEFAULT_SENDER=no-reply@example.com

# ─── Logging & Rate Limiting ───
LOG_LEVEL=INFO
# Use Redis (e.g. redis://redis:6379/0) in production for multi-worker consistency
RATELIMIT_STORAGE_URI=memory://
