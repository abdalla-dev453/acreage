# ─── Acreage Frontend Environment Variables ───
# Vite exposes variables prefixed with VITE_ to the client.
# In production, set these in your hosting platform's environment config.

# API base URL — points to your Flask backend
# Examples:
#   Development: http://localhost:5000
#   Production:  https://acreage-n2h1.onrender.com
VITE_API_URL=http://localhost:5000
