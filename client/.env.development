# Development environment variables
# Keep empty in local dev so Vite dev server proxy forwards /api to backend
# without browser Local Network Access / Private Network Access CORS blocks
VITE_API_URL=
VITE_SMS_NUMBER=0182142621
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false

# Performance optimization flags (disabled in dev for easier debugging)
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_OFFLINE_SUPPORT=true
VITE_CACHE_STRATEGY=networkFirst
VITE_IMAGE_OPTIMIZATION=false
