FLASK_APP=app.py
# Set to "false" in production. Never run with debug=true when deployed.
FLASK_DEBUG=true

# Generate strong random values for these two in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value
JWT_SECRET_KEY=change-me-to-a-different-long-random-value

# Local dev default (SQLite). In production, point this at Postgres instead.
DATABASE_URL=sqlite:///../instance/acreage.db

# Comma-separated list of frontend origins allowed to call this API.
# Example production value: https://acreage.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

